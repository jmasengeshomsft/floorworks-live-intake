{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "createAcs": { "value": "${CREATE_ACS=false}" },
    "createFoundry": { "value": "${CREATE_FOUNDRY=false}" },
    "existingAcsName": { "value": "${ACS_NAME=}" },
    "existingFoundryAccountName": { "value": "${FOUNDRY_ACCOUNT_NAME=}" },
    "existingFoundryResourceGroup": { "value": "${FOUNDRY_RESOURCE_GROUP=${AZURE_RESOURCE_GROUP}}" },
    "existingFoundryProjectName": { "value": "${FOUNDRY_PROJECT_NAME=firstProject}" },
    "dataverseUrl": { "value": "${DATAVERSE_URL}" },
    "transferTeamsObjectIds": { "value": "${TRANSFER_TEAMS_OBJECT_IDS=}" },
    "apiKeys": { "value": "${API_KEYS}" },
    "gatewaySecret": { "value": "${GATEWAY_SECRET}" },
    "eventgridSecret": { "value": "${EVENTGRID_SECRET}" },
    "voiceAgentName": { "value": "${VOICE_AGENT_NAME=intake-voice-agent}" },
    "extractorAgentName": { "value": "${EXTRACTOR_AGENT_NAME=intake-note-taker}" },
    "brandName": { "value": "${BRAND_NAME=Intake}" },
    "corsOrigins": { "value": "${CORS_ORIGINS=}" },
    "enrichment": { "value": "${ENRICHMENT=off}" },
    "afterHours": { "value": "${AFTER_HOURS=off}" },
    "serviceTz": { "value": "${SERVICE_TZ=America/Chicago}" },
    "serviceDays": { "value": "${SERVICE_DAYS=Mon-Fri}" },
    "serviceHours": { "value": "${SERVICE_HOURS=07:00-18:00}" },
    "deploySearch": { "value": "${DEPLOY_SEARCH=true}" },
    "runnerPrincipalId": { "value": "${RUNNER_PRINCIPAL_ID=}" },
    "ringback": { "value": "${RINGBACK=on}" }
  }
}
