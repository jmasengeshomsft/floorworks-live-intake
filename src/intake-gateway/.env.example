# Required
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
ACS_CONNECTION_STRING=endpoint=https://<acs>.communication.azure.com/;accesskey=...
PUBLIC_BASE_URL=https://<your-public-host>
VOICE_AGENT_NAME=my-voice-agent
EXTRACTOR_AGENT_NAME=my-extractor-agent

# Consumer API
API_KEYS=                     # comma separated; REQUIRED unless LOCAL_DEV=1 (generate long random values)

# Infra endpoint auth (/api/incoming, /api/callbacks, /ws): all REQUIRED unless LOCAL_DEV=1
GATEWAY_SECRET=               # HMAC key for per-call tokens appended to callback / media URLs
EVENTGRID_SECRET=             # shared secret Event Grid must send to /api/incoming (?s= or aeg-sas-key)
ACS_JWT_MODE=enforce          # enforce (default; only enforce is allowed outside LOCAL_DEV) | warn | off
ACS_RESOURCE_ID=              # ACS immutable resource id (JWT audience)
LINE_NUMBERS=                 # optional comma separated allow-list of dialed numbers
WEBHOOK_URLS=                 # comma separated; HMAC-signed POSTs
WEBHOOK_SECRET=

# Optional
EXTRACTION_SCHEMA=            # JSON passed to the extractor agent
ENRICHMENT=off                # on|off
ENRICHMENT_INTERVAL_S=15
TRANSFER_TEAMS_OBJECT_IDS=    # comma separated Entra object ids
RINGBACK=on
# Live notes after transfer (Azure Speech STT). on by default; off to omit.
LIVE_NOTES=on
SPEECH_KEY=
# Or keyless: SPEECH_AUTH=aad + SPEECH_RESOURCE_ID (managed identity needs "Cognitive Services Speech User")
SPEECH_AUTH=
SPEECH_RESOURCE_ID=
# Call limits
MAX_CONCURRENT_CALLS=50
MAX_CALL_DURATION_SECONDS=3600
IDLE_TIMEOUT_SECONDS=120
# Browser UI
CORS_ORIGINS=                 # comma separated origins, e.g. http://localhost:5173
DEV_SIMULATOR=off             # on = POST /v1/dev/simulate plays a fake call
SPEECH_REGION=eastus
SPEECH_LANGUAGE=en-US
VOICE_SESSION_TUNING=off
GREETING_CONTEXT=
FUNCTIONS=                    # JSON list of consumer-webhook functions
AFTER_HOURS=off
SERVICE_TZ=UTC
SERVICE_DAYS=Mon,Tue,Wed,Thu,Fri
SERVICE_HOURS=08:00-17:00
LOCAL_DEV=0                   # 1 = use az login credentials
